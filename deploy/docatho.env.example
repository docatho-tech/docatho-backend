# Copy to /etc/docatho/docatho.env on the EC2 host and fill in real values.
# This file is loaded by systemd (EnvironmentFile) and by deploy/deploy.sh.
# Keep it root-owned and chmod 600 — it holds secrets.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_READ_DOT_ENV_FILE=False
DJANGO_DEBUG=False
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=api.example.com
# Non-guessable admin path, e.g. "skbf83jd-admin/" (trailing slash, no leading slash). REQUIRED in production.
DJANGO_ADMIN_URL=CHANGE_ME-admin/
DJANGO_SECURE_SSL_REDIRECT=True

# --- Database (Postgres) ---
POSTGRES_DB=docatho
POSTGRES_USER=docatho
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CONN_MAX_AGE=60

# --- Redis (cache + celery broker/result) ---
REDIS_URL=redis://127.0.0.1:6379/0
# Optional; default to REDIS_URL if unset.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- AWS S3 (static + media via django-storages). REQUIRED in production. ---
DJANGO_AWS_ACCESS_KEY_ID=CHANGE_ME
DJANGO_AWS_SECRET_ACCESS_KEY=CHANGE_ME
DJANGO_AWS_STORAGE_BUCKET_NAME=docatho-media
DJANGO_AWS_S3_REGION_NAME=ap-south-1

# --- Email (Anymail/SMTP) ---
DJANGO_DEFAULT_FROM_EMAIL=docatho <noreply@example.com>
DJANGO_SERVER_EMAIL=noreply@example.com

# --- Razorpay ---
RZP_TEST_ID=
RZP_TEST_SECRET=
RZP_WEBHOOK_SECRET=

# --- Pharmacy tunables (optional; defaults in settings) ---
# PHARMACY_COMMISSION_PERCENT=10
# PHARMACY_DELIVERY_FEE=0
# PHARMACY_ORDER_DISCOUNT_PERCENT=15
