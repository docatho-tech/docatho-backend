[Unit]
Description=docatho celery beat (periodic task scheduler)
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User=docatho
Group=www-data
RuntimeDirectory=docatho
WorkingDirectory=/opt/docatho/docatho-backend
EnvironmentFile=/etc/docatho/docatho.env
ExecStart=/opt/docatho/docatho-backend/.venv/bin/celery \
    -A config.celery_app beat \
    --loglevel=info \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler \
    --pidfile=/run/docatho/celerybeat.pid
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
